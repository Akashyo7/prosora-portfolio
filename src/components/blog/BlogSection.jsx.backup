import { useState, useEffect } from 'react';
import { motion } from 'framer-motion';
import { Calendar, Clock, Tag, ArrowRight, Mail, ExternalLink } from 'lucide-react';
import ghostBlogService from '../../services/ghostBlogService.js';
import { getAccessibleVariants } from '../../utils/accessibility.js';
import { generateMetaTags, updateDocumentHead, sectionSEO } from '../../utils/seo.js';
import './BlogSection.css';

const BlogSection = () => {
  const [posts, setPosts] = useState([]);
  const [loading, setLoading] = useState(true);
  const [currentSlide, setCurrentSlide] = useState(0);
  const [error, setError] = useState(null);

  // Load blog posts from Ghost
  useEffect(() => {
    const loadPosts = async () => {
      try {
        setLoading(true);
        setError(null);
        console.log('🔄 Loading blog posts from Ghost...');
        
        const blogPosts = await ghostBlogService.fetchLatestPosts();
        console.log('✅ Ghost blog posts loaded:', blogPosts.length, 'posts');
        console.log('📝 Posts data:', blogPosts);
        
        setPosts(blogPosts);
        
        // Update SEO meta tags with blog data
        const blogSEO = generateMetaTags(
          { ...sectionSEO.blog, section: 'blog' },
          blogPosts
        );
        updateDocumentHead(blogSEO);
      } catch (error) {
        console.error('❌ Failed to load Ghost blog posts:', error);
        setError(error.message);
        
        // Use fallback posts on error
        const fallbackPosts = ghostBlogService.getFallbackPosts();
        setPosts(fallbackPosts);
        
        // Still update SEO for blog section even on error
        const blogSEO = generateMetaTags(
          { ...sectionSEO.blog, section: 'blog' },
          []
        );
        updateDocumentHead(blogSEO);
      } finally {
        setLoading(false);
        console.log('🏁 Ghost blog loading completed');
      }
    };

    loadPosts();
  }, []);

  // Simple navigation - pairs of posts (matching WorkSection)
  const totalSlides = Math.ceil(posts.length / 2);
  
  // Auto-play functionality - matching WorkSection
  useEffect(() => {
    if (totalSlides <= 1) return;
    
    const interval = setInterval(() => {
      setCurrentSlide((prev) => (prev + 1) % totalSlides);
    }, 6000); // Slightly slower for reading
    
    return () => clearInterval(interval);
  }, [totalSlides]);

  const goToSlide = (slideIndex) => {
    setCurrentSlide(slideIndex);
  };

  // Animation variants
  const containerVariants = getAccessibleVariants({
    hidden: { opacity: 0 },
    visible: {
      opacity: 1,
      transition: {
        staggerChildren: 0.1,
        duration: 0.6
      }
    }
  });

  // Newsletter Signup Component (Option A - after header, before cards)
  const NewsletterSignup = () => (
    <motion.div 
      className="newsletter-signup-container mb-12"
      initial={{ opacity: 0, y: 20 }}
      whileInView={{ opacity: 1, y: 0 }}
      transition={{ duration: 0.6 }}
      viewport={{ once: true }}
    >
      <div className="newsletter-signup bg-gradient-to-r from-blue-50 to-indigo-50 rounded-xl p-6 text-center border border-blue-100">
        <div className="flex items-center justify-center mb-3">
          <Mail className="w-5 h-5 text-blue-600 mr-2" />
          <h3 className="text-lg font-semibold text-gray-900">Stay Updated</h3>
        </div>
        <p className="text-gray-600 mb-4 text-sm">
          Get the latest insights on product management, strategy, and professional growth delivered to your inbox.
        </p>
        <a
          href="https://prosora.blog/#/portal/signup"
          target="_blank"
          rel="noopener noreferrer"
          className="inline-flex items-center px-6 py-2.5 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition-colors duration-200 text-sm"
        >
          Subscribe to Newsletter
          <ExternalLink className="w-4 h-4 ml-2" />
        </a>
      </div>
    </motion.div>
  );

  console.log('🔍 Blog render - Posts:', posts.length, 'Loading:', loading, 'Error:', error);

  return (
    <>
      {/* Blog Header Section - matching WorkSection structure */}
      <section id="blog" className="h2---section---about">
        <motion.a 
          href="https://prosora.blog"
          target="_blank"
          rel="noopener noreferrer"
          className="h2---link-block w-inline-block block text-center py-16"
          initial={{ opacity: 0, y: 30 }}
          whileInView={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.6 }}
          viewport={{ once: true }}
        >
          <motion.h2 
            className="h2---text text-black mb-6"
            whileHover={{ scale: 1.02 }}
            transition={{ duration: 0.3 }}
          >
            blog<span style={{ color: '#f8cb74' }}>.</span>
          </motion.h2>
          <div className="h2---o about">
            <p className="paragraph text-lg md:text-xl font-medium text-gray-600">
              Insights on product management, strategy, and my professional journey
            </p>
          </div>
        </motion.a>
      </section>

      {/* Blog Content Section */}
      <section className="blog bg-white py-20">
        <div className="container mx-auto px-6">
          <motion.div
            variants={containerVariants}
            initial="hidden"
            whileInView="visible"
            viewport={{ once: true, margin: "-100px" }}
          >
            {/* Newsletter Signup - Option A */}
            <NewsletterSignup />

            {/* Layered Structure - Background + Cards + Navigation (matching WorkSection) */}
            <div className="blog-container relative">
              {/* Background Layer */}
              <div className="blog-background absolute inset-0 -z-10"></div>
              
              {/* Cards Layer - Uniform Structure with Smart Placeholder */}
              <div className="blog-cards-container max-w-7xl mx-auto px-4 py-12">
                {loading ? (
                  <div className="text-center py-12">
                    <div className="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
                    <p className="mt-4 text-gray-600">Loading latest posts...</p>
                  </div>
                ) : posts.length === 0 ? (
                  <div className="text-center py-12">
                    <p className="text-gray-600">No blog posts available at the moment.</p>
                    <a 
                      href="https://prosora.blog" 
                      target="_blank" 
                      rel="noopener noreferrer"
                      className="inline-flex items-center mt-4 text-blue-600 hover:text-blue-700 font-medium"
                    >
                      Visit Blog <ExternalLink className="w-4 h-4 ml-1" />
                    </a>
                  </div>
                ) : (
                  <>
                    <div className="blog-grid grid grid-cols-2 gap-6 md:gap-8 lg:gap-12">
                      {(() => {
                        const currentPosts = posts.slice(currentSlide * 2, currentSlide * 2 + 2);
                        const needsPlaceholder = currentPosts.length === 1;
                        
                        return (
                          <>
                            {currentPosts.map((post) => (
                              <div key={post.id} className="blog-card">
                                <a
                                  href={post.url}
                                  target="_blank"
                                  rel="noopener noreferrer"
                                  className="blog-card-link block group"
                                >
                                  {/* Uniform Image Container - matching WorkSection */}
                                  <div className="blog-image-container">
                                    <div className="blog-image-wrapper">
                                      {post.feature_image ? (
                                        <img
                                          src={post.feature_image}
                                          alt={post.title}
                                          className="blog-image"
                                          loading="lazy"
                                          onLoad={() => {
                                            console.log('✅ Blog image loaded successfully:', post.title);
                                          }}
                                          onError={(e) => {
                                            console.log('❌ Blog image failed to load:', post.title);
                                            e.target.style.display = 'none';
                                            e.target.nextElementSibling.style.display = 'flex';
                                          }}
                                        />
                                      ) : null}
                                      <div 
                                        className="blog-image-placeholder blog-gradient-placeholder"
                                        style={{ display: post.feature_image ? 'none' : 'flex' }}
                                      >
                                        <div className="placeholder-content">
                                          <div className="placeholder-icon">📝</div>
                                          <div className="placeholder-text">Blog Post</div>
                                          <div className="placeholder-subtitle">prosora.blog</div>
                                        </div>
                                      </div>
                                    </div>
                                  </div>
                                  
                                  {/* Uniform Typography Container - matching WorkSection */}
                                  <div className="blog-text-container">
                                    <div className="blog-project-type">
                                      {post.primary_tag?.name || 'BLOG POST'} • {new Date(post.published_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
                                    </div>
                                    <div className="blog-project-title">
                                      "{post.title}"
                                    </div>
                                  </div>
                                </a>
                              </div>
                            ))}
                            
                            {/* Smart Placeholder Card - Only when needed (matching WorkSection) */}
                            {needsPlaceholder && (
                              <div className="blog-card blog-placeholder-card">
                                <div className="blog-card-link block group cursor-default">
                                  {/* Placeholder Image Container */}
                                  <div className="blog-image-container">
                                    <div className="blog-image-wrapper">
                                      <div className="blog-image-placeholder blog-smart-placeholder">
                                        <div className="placeholder-content">
                                          <div className="placeholder-icon">✍️</div>
                                          <div className="placeholder-text">More Coming Soon</div>
                                        </div>
                                      </div>
                                    </div>
                                  </div>
                                  
                                  {/* Placeholder Typography Container */}
                                  <div className="blog-text-container">
                                    <div className="blog-project-type blog-placeholder-type">
                                      UPCOMING POST
                                    </div>
                                    <div className="blog-project-title blog-placeholder-title">
                                      "Stay Connected"
                                    </div>
                                  </div>
                                </div>
                              </div>
                            )}
                          </>
                        );
                      })()}
                    </div>

                    {/* Descriptions Layer - Between Cards and Navigation (matching WorkSection) */}
                    <div className="blog-descriptions">
                      <div className="blog-descriptions-container">
                        {(() => {
                          const currentPosts = posts.slice(currentSlide * 2, currentSlide * 2 + 2);
                          const needsPlaceholder = currentPosts.length === 1;
                          
                          return (
                            <div className="blog-descriptions-grid">
                              {currentPosts.map((post) => (
                                <div key={`desc-${post.id}`} className="blog-description">
                                  <p className="blog-description-text">
                                    {post.excerpt || post.custom_excerpt || 'Discover insights and strategies that drive product success and professional growth.'}
                                  </p>
                                </div>
                              ))}
                              
                              {/* Smart Placeholder Description - Only when needed */}
                              {needsPlaceholder && (
                                <div className="blog-description blog-placeholder-description">
                                  <p className="blog-description-text blog-placeholder-description-text">
                                    More insights on product management, strategy, and professional growth coming soon.
                                  </p>
                                </div>
                              )}
                            </div>
                          );
                        })()}
                      </div>
                    </div>

                    {/* Navigation Layer - Small Elegant Dots (matching WorkSection) */}
                    {totalSlides > 1 && (
                      <div className="blog-navigation">
                        <div className="blog-dots-container">
                          {Array.from({ length: totalSlides }).map((_, index) => (
                            <button
                              key={index}
                              onClick={() => goToSlide(index)}
                              className={`blog-dot ${currentSlide === index ? 'blog-dot-active' : ''}`}
                              aria-label={`Go to slide ${index + 1}`}
                            />
                          ))}
                        </div>
                      </div>
                    )}
                  </>
                )}
              </div>
            </div>

            {/* Call to Action - Visit Full Blog */}
            <motion.div 
              className="text-center mt-12"
              initial={{ opacity: 0, y: 20 }}
              whileInView={{ opacity: 1, y: 0 }}
              transition={{ duration: 0.6, delay: 0.2 }}
              viewport={{ once: true }}
            >
              <p className="text-gray-600 mb-6">
                Explore more insights and in-depth articles
              </p>
              <a
                href="https://prosora.blog"
                target="_blank"
                rel="noopener noreferrer"
                className="inline-flex items-center px-8 py-3 bg-gradient-to-r from-blue-600 to-purple-600 text-white font-semibold rounded-full hover:from-blue-700 hover:to-purple-700 transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-xl"
              >
                Visit Full Blog
                <ExternalLink className="w-5 h-5 ml-2" />
              </a>
            </motion.div>
          </motion.div>
        </div>
      </section>
    </>
  );
};

export default BlogSection;